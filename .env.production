# ============================================================================
# TAIGA PRODUCTION ENVIRONMENT CONFIGURATION FOR v2.oppwatch.com
# ============================================================================
# Deployment: Coolify v4.0 on srv2 (108.171.195.235)
# Domain: v2.oppwatch.com
# Created: 2025-11-16
# ============================================================================

# ============================================================================
# TAIGA'S URLs - Where Taiga should be served
# ============================================================================
TAIGA_SCHEME=https                    # Use HTTPS (Coolify proxy manages SSL)
TAIGA_DOMAIN=v2.oppwatch.com          # Production domain
SUBPATH=""                            # No subpath - serve at root
WEBSOCKETS_SCHEME=wss                 # Secure WebSocket (WSS)

# ============================================================================
# TAIGA'S SECRET KEY - Cryptographic signing (CHANGE THIS!)
# ============================================================================
# IMPORTANT: Generate a new random value!
# Command to generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY="CHANGE-THIS-TO-A-RANDOM-VALUE-RUN-COMMAND-ABOVE-FOR-SECURE-KEY-GENERATION"

# ============================================================================
# TAIGA'S DATABASE SETTINGS
# ============================================================================
POSTGRES_DB=taiga_production
POSTGRES_USER=taiga_prod_user
POSTGRES_PASSWORD="CHANGE-THIS-STRONG-PASSWORD-USE-RANDOM-VALUE"

# ============================================================================
# TAIGA'S SMTP SETTINGS - Email delivery
# ============================================================================
# Option 1: Console (emails printed to logs - development only)
# EMAIL_BACKEND=console

# Option 2: SMTP Server (production recommended)
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.gmail.com                    # SMTP server address
EMAIL_PORT=587                               # SMTP port (587 for TLS, 465 for SSL)
EMAIL_HOST_USER=your-email@gmail.com         # SMTP authentication user
EMAIL_HOST_PASSWORD=your-app-password        # SMTP authentication password (use app-specific password for Gmail)
EMAIL_DEFAULT_FROM=noreply@v2.oppwatch.com   # From address for automated emails
EMAIL_USE_TLS=True                           # Use TLS (for port 587)
EMAIL_USE_SSL=False                          # Don't use SSL (TLS is set to True)

# ============================================================================
# TAIGA'S RABBITMQ SETTINGS - Real-time events & async tasks
# ============================================================================
RABBITMQ_USER=taiga_rmq_user
RABBITMQ_PASS="CHANGE-THIS-STRONG-PASSWORD-UNIQUE-FOR-RABBITMQ"
RABBITMQ_VHOST=taiga_prod
RABBITMQ_ERLANG_COOKIE="unique-erlang-cookie-generate-random-value-here"

# ============================================================================
# TAIGA'S ATTACHMENTS - File expiration settings
# ============================================================================
# Token expiration time in seconds (360 = 6 minutes)
ATTACHMENTS_MAX_AGE=360

# ============================================================================
# TAIGA'S TELEMETRY - Usage data collection (optional)
# ============================================================================
# Set to False to disable anonymous telemetry
ENABLE_TELEMETRY=False

# ============================================================================
# ADVANCED SETTINGS - Only modify if you know what you're doing
# ============================================================================

# Public registration - Set both to enable self-registration
# PUBLIC_REGISTER_ENABLED_BACKEND=True
# PUBLIC_REGISTER_ENABLED_FRONTEND=true

# GitHub OAuth (optional)
# ENABLE_GITHUB_AUTH=True
# GITHUB_API_CLIENT_ID=your-github-client-id
# GITHUB_API_CLIENT_SECRET=your-github-client-secret

# GitLab OAuth (optional)
# ENABLE_GITLAB_AUTH=True
# GITLAB_API_CLIENT_ID=your-gitlab-client-id
# GITLAB_API_CLIENT_SECRET=your-gitlab-client-secret
# GITLAB_URL=https://gitlab.com

# Slack Integration (optional)
# ENABLE_SLACK=True

# ============================================================================
# NOTES & SECURITY REMINDERS
# ============================================================================
# 1. NEVER commit this file with real credentials to version control
# 2. Store securely in Coolify secrets management
# 3. Change all default passwords before first deployment
# 4. Rotate SECRET_KEY if compromised
# 5. Monitor logs for security issues: docker compose logs -f taiga-back
# 6. Regular backups of taiga-db-data volume
# ============================================================================
